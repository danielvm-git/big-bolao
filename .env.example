# === Telegram ===
# Pegue com o @BotFather: /newbot -> copie o token
TELEGRAM_TOKEN=123456:ABC-...

# Chat ID do grupo onde o bot posta ranking/lembretes/resultados (negativo).
# Como pegar: adicione o bot ao grupo e mande /chatid
GRUPO_CHAT_ID=-1001234567890

# Telegram IDs dos admins (virgula) que podem usar /resultado, /sync, /lembrete
ADMIN_IDS=11111111

# === BigBase (backend de dados) ===
# URL da sua instancia BigBase
BIGBASE_URL=https://bigbase.click
# Credenciais de uma conta de servico criada no BigBase (/api/auth/register)
BIGBASE_EMAIL=bolao-bot@bigbase.local
BIGBASE_PASSWORD=troque-isto

# === Provedor de resultados (opcional) ===
# Vazio = modo manual (admin digita /resultado). "apifootball" = puxa automatico.
RESULTS_PROVIDER=
APIFOOTBALL_KEY=
# ID da liga Copa 2026 no apifootball.com
# Descubra: curl "https://apiv3.apifootball.com/?action=get_leagues&APIkey=SUA_CHAVE" | jq '.[] | select(.league_name | test("World Cup"))'
APIFOOTBALL_LEAGUE_ID=28
APIFOOTBALL_SEASON=2026

# Fuso dos horarios da agenda (a planilha esta em BRT)
TIMEZONE=America/Sao_Paulo
